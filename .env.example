# --- Database -------------------------------------------------------------
# Local development (default): SQLite file, no setup needed.
DATABASE_URL=sqlite+aiosqlite:///./local.db
# Supabase: Dashboard -> Connect -> "Transaction pooler" URI (port 6543).
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- Processing -----------------------------------------------------------
# inline   -> process in a FastAPI background task after the 202 (local / long-lived server)
# supabase -> a Postgres trigger calls POST /v1/internal/process (Vercel / serverless)
PROCESSING_TRIGGER=inline
PROCESSING_DELAY_SECONDS=30

# Shared secret the Supabase trigger sends in the X-Internal-Secret header.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_SECRET=change-me

# Create tables on startup. Keep true locally; set false on Vercel (schema comes from supabase/migrations).
AUTO_CREATE_TABLES=true
